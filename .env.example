# Copy to .env (docker compose reads it automatically). NEVER commit the real .env.
#
# Everything below is OPTIONAL. Without it the full lakehouse (Kafka -> Spark ->
# Delta Lake on MinIO -> Great Expectations) runs locally, and Airflow skips the
# Snowflake / dbt branch instead of failing.

# --- Snowflake (enables Silver -> Snowflake RAW -> dbt) ----------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=STREAMING_DB
SNOWFLAKE_SCHEMA=RAW_SCHEMA
SNOWFLAKE_DBT_SCHEMA=DBT_DEV

# --- MinIO (local S3). Change if you expose the ports beyond localhost. ------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
